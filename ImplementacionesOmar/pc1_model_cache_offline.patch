+export async function loadChecksumsWithCache(
+  url = '/models/checksums.json',
+  deps: Pick<InstallDeps, 'fetch' | 'caches'> = defaultDeps,
+): Promise<ChecksumsMap> {
+  const cache = await deps.caches.open(CACHE_NAME)
+
+  try {
+    const response = await deps.fetch(url, { cache: 'no-cache' })
+    if (response.ok) {
+      const checksums = (await response.json()) as ChecksumsMap
+      const cachedResponse = new Response(JSON.stringify(checksums), {
+        headers: { 'Content-Type': 'application/json' },
+      })
+      await cache.put(cacheKey('checksums.json'), cachedResponse.clone())
+      await cache.put(url, cachedResponse)
+      return checksums
+    }
+  } catch {
+    // Sin conexión o error de red: se intenta recuperar la copia en caché local.
+  }
+
+  const cached = (await cache.match(cacheKey('checksums.json'))) ?? (await cache.match(url))
+  if (cached) {
+    return (await cached.json()) as ChecksumsMap
+  }
+
+  throw new Error('No se pudo obtener checksums.json ni desde la caché local')
+}
+
+export async function verifyCachedModels(
+  specs: ModelSpec[],
+  deps: InstallDeps = defaultDeps,
+): Promise<{ ready: boolean; cached: string[]; missing: string[] }> {
+  const cache = await deps.caches.open(CACHE_NAME)
+  const cached: string[] = []
+  const missing: string[] = []
+
+  for (const spec of specs) {
+    if (await isCachedAndVerified(spec, cache, deps.digest)) {
+      cached.push(spec.name)
+    } else {
+      missing.push(spec.name)
+    }
+  }
+
+  return {
+    ready: specs.length > 0 && missing.length === 0,
+    cached,
+    missing,
+  }
+}
